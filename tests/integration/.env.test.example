# Test Environment Configuration
# Copy this file to .env.test and update with your actual test credentials

# Enable real service testing (set to true for full integration tests)
ENABLE_REAL_SERVICES=false

# API Configuration
TEST_API_BASE_URL=http://localhost:8000
TEST_TIMEOUT=300

# Stagehand/Browserbase Configuration (required for real browser automation tests)
TEST_STAGEHAND_API_KEY=your-stagehand-api-key-here
TEST_BROWSERBASE_PROJECT_ID=your-browserbase-project-id-here

# Test Account Credentials (required for real service tests)
# Z.AI
TEST_ZAI_EMAIL=developer@pixelium.uk
TEST_ZAI_PASSWORD=developer123?

# Qwen.AI
TEST_QWEN_EMAIL=developer@pixelium.uk
TEST_QWEN_PASSWORD=developer1?

# DeepSeek
TEST_DEEPSEEK_EMAIL=zeeeepa+1@gmail.com
TEST_DEEPSEEK_PASSWORD=developer123??

# K2Think
TEST_K2THINK_EMAIL=developer@pixelium.uk
TEST_K2THINK_PASSWORD=developer123?

# Grok
TEST_GROK_EMAIL=developer@pixelium.uk
TEST_GROK_PASSWORD=developer123??

# Test Configuration
TEST_MESSAGE_TIMEOUT=120
TEST_LOGIN_TIMEOUT=60
TEST_HEALTH_CHECK_INTERVAL=10

# Logging
TEST_LOG_LEVEL=INFO
TEST_ENABLE_DEBUG_LOGGING=false
