# Chat Proxy Configuration
# Copy this file to .env.chat_proxy and update with your actual values

# Stagehand/Browserbase Configuration
STAGEHAND_API_KEY=your-stagehand-api-key-here
BROWSERBASE_PROJECT_ID=your-browserbase-project-id-here

# Chat Service Accounts
# Z.AI
ZAI_EMAIL=developer@pixelium.uk
ZAI_PASSWORD=developer123?

# Qwen.AI
QWEN_EMAIL=developer@pixelium.uk
QWEN_PASSWORD=developer1?

# DeepSeek
DEEPSEEK_EMAIL=zeeeepa+1@gmail.com
DEEPSEEK_PASSWORD=developer123??

# K2Think
K2THINK_EMAIL=developer@pixelium.uk
K2THINK_PASSWORD=developer123?

# Grok
GROK_EMAIL=developer@pixelium.uk
GROK_PASSWORD=developer123??

# Load Balancing Configuration
DEFAULT_LOAD_BALANCING_STRATEGY=round_robin  # round_robin, least_used, health_based, weighted

# Rate Limiting
MAX_REQUESTS_PER_HOUR=100
MAX_REQUESTS_PER_DAY=1000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=300  # seconds
MAX_CONSECUTIVE_ERRORS=3

# Session Configuration
SESSION_TIMEOUT=3600  # seconds
MAX_CONCURRENT_SESSIONS=5

# Logging
CHAT_PROXY_LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true

# API Configuration
CHAT_PROXY_API_KEY=your-chat-proxy-api-key-here
ENABLE_STREAMING=true
DEFAULT_RESPONSE_TIMEOUT=120  # seconds
