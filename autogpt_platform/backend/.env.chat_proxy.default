# Chat Proxy Configuration
# Copy this file to .env.chat_proxy and update with your actual values

# Stagehand/Browserbase Configuration
STAGEHAND_API_KEY=your-stagehand-api-key-here
BROWSERBASE_PROJECT_ID=your-browserbase-project-id-here

# Chat Service Accounts
# Z.AI
ZAI_EMAIL=your-zai-email@example.com
ZAI_PASSWORD=your-zai-password

# Qwen.AI
QWEN_EMAIL=your-qwen-email@example.com
QWEN_PASSWORD=your-qwen-password

# DeepSeek
DEEPSEEK_EMAIL=your-deepseek-email@example.com
DEEPSEEK_PASSWORD=your-deepseek-password

# K2Think
K2THINK_EMAIL=your-k2think-email@example.com
K2THINK_PASSWORD=your-k2think-password

# Grok
GROK_EMAIL=your-grok-email@example.com
GROK_PASSWORD=your-grok-password

# Load Balancing Configuration
DEFAULT_LOAD_BALANCING_STRATEGY=round_robin  # round_robin, least_used, health_based, weighted

# Rate Limiting
MAX_REQUESTS_PER_HOUR=100
MAX_REQUESTS_PER_DAY=1000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=300  # seconds
MAX_CONSECUTIVE_ERRORS=3

# Scaling Engine Configuration
SCALING_IDLE_TIMEOUT_MINUTES=15
SCALING_MIN_INSTANCES=1
SCALING_MAX_INSTANCES=unlimited  # or a number like 10
SCALING_PROVIDERS_PER_INSTANCE=5
SCALING_COOLDOWN_SECONDS=30
SCALING_UP_THRESHOLD=0.8
SCALING_DOWN_THRESHOLD=0.3

# Session Configuration
SESSION_TIMEOUT=3600  # seconds
MAX_CONCURRENT_SESSIONS=5

# Logging
CHAT_PROXY_LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true

# API Configuration
CHAT_PROXY_API_KEY=your-chat-proxy-api-key-here
ENABLE_STREAMING=true
DEFAULT_RESPONSE_TIMEOUT=120  # seconds
